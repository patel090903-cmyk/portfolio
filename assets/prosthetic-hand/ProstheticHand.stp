#38860=PRODUCT_CONTEXT('part definition',#38859,'mechanical');
#38861=PRODUCT('PH-ASM-001','ProstheticHand',
'Tendon-driven prosthetic hand (right, adult male 50th pct.): 4 PQ12-P
 finger actuators, 2 HS-82MG thumb servos, underactuated 3-phalanx fin
gers, 1/2-20 wrist, forearm electronics bay',(#38860));
#38862=PRODUCT('PH-101','PalmChassis',
'Palm chassis, PETG printed: 4 PQ12-P actuator bays with lug clevises 
(3 mm pins), knuckle clevises for 4 fingers (3 mm press pins), tendon 
guides, thenar pocket for the HS-82MG rotation servo, thumb yoke reces
s + pivot bracket, wrist boss with captive 1/2-20 bolt head',(#38860));
#38863=PRODUCT('PH-102','PalmCover',
'Palm cover (dorsal), PETG printed 3 mm, 6 x M2 thread-forming screws 
into the chassis walls',(#38860));
#38864=PRODUCT('PA-040','Screw_M2x8_PT',
'Thread-forming screw for plastics M2 x 8, pan head, A2 (cover to chas
sis)',(#38860));
#38865=PRODUCT('PA-030','HexBolt_1-2-20x0.75',
'Hex bolt 1/2-20 UNF x 3/4 in, grade 5 zinc: the standard prosthetic w
rist thread, head captive in the palm',(#38860));
#38866=PRODUCT('PH-201','ForearmBay',
'Forearm electronics bay, PLA printed: 56 OD x 78 tube (2 mm wall), 14
 mm distal wall with captive 1/2-20 jam nut (standard prosthetic wrist
 thread), holds battery, controller, drivers, regulator',(#38860));
#38867=PRODUCT('PH-202','SocketFlange',
'Socket flange, PLA printed: closes the bay, 4 x M4 on 60 PCD to the p
atient''s laminated socket plate (socket itself is custom and not mode
lled)',(#38860));
#38868=PRODUCT('PA-031','JamNut_1-2-20',
'Hex jam nut 1/2-20 UNF, grade 5 zinc, captive in the forearm bay wall',
(#38860));
#38869=PRODUCT('PE-001','Battery_2S_800',
'LiPo battery 2S 7.4 V 800 mAh (5.9 Wh), e.g. Ovonic 2S 800 mAh; envel
ope 58 x 31 x 13',(#38860));
#38870=PRODUCT('PE-002','Arduino_NanoEvery',
'Controller Arduino Nano Every (ABX00028), ATmega4809, reads 2 EMG cha
nnels + 4 actuator pots',(#38860));
#38871=PRODUCT('PE-004','Regulator_D24V50F6',
'Step-down regulator Pololu D24V50F6, 6 V 5 A (actuators + servos)',(#38860));
#38872=PRODUCT('PE-003','Driver_DRV8833',
'Dual H-bridge carrier Pololu DRV8833 (#2130), 2 actuators each',(#38860));
#38873=PRODUCT('PH-111','Index_P1',
'Index finger phalanx P1, PETG printed: 42 pin-to-pin, 20 x 16, 3 mm p
in joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38874=PRODUCT('PH-112','Index_P2',
'Index finger phalanx P2, PETG printed: 25 pin-to-pin, 20 x 16, 3 mm p
in joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38875=PRODUCT('PH-113','Index_P3',
'Index finger phalanx P3, PETG printed: 22 joint-to-tip, 20 x 16, 3 mm
 pin joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38876=PRODUCT('PH-121','Middle_P1',
'Middle finger phalanx P1, PETG printed: 45 pin-to-pin, 20 x 16, 3 mm 
pin joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38877=PRODUCT('PH-122','Middle_P2',
'Middle finger phalanx P2, PETG printed: 27 pin-to-pin, 20 x 16, 3 mm 
pin joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38878=PRODUCT('PH-123','Middle_P3',
'Middle finger phalanx P3, PETG printed: 23 joint-to-tip, 20 x 16, 3 m
m pin joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38879=PRODUCT('PH-131','Ring_P1',
'Ring finger phalanx P1, PETG printed: 42 pin-to-pin, 19 x 16, 3 mm pi
n joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38880=PRODUCT('PH-132','Ring_P2',
'Ring finger phalanx P2, PETG printed: 26 pin-to-pin, 19 x 16, 3 mm pi
n joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38881=PRODUCT('PH-133','Ring_P3',
'Ring finger phalanx P3, PETG printed: 22 joint-to-tip, 19 x 16, 3 mm 
pin joints, flexor channel 1.2, dorsal elastic channel 2.0',(#38860));
#38882=PRODUCT('PA-021','Dowel_3x18',
'Dowel pin ISO 8734 3 m6 x 18, stainless A2 (joint / actuator pins)',(#38860));
#38883=PRODUCT('PA-001','PQ12_Body',
'Linear actuator Actuonix PQ12-100-6-P: 20 mm stroke, 100:1, 6 V, pote
ntiometer feedback; 40 N at 6 mm/s (peak power), 50 N max, 35 N back-d

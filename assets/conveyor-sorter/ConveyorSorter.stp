#30357=PRODUCT_CONTEXT('part definition',#30356,'mechanical');
#30358=PRODUCT('CS-ASM-001','ConveyorSorter',
'Belt conveyor with automatic size sorting: 200 mm PVC belt at 0.25 m/
s, goBILDA 50.9:1 drive, ToF + through-beam sensing, 2 servo swing-arm
 diverters, 3 bins (driven by TakeUp / Divert1 / Divert2)',(#30357));
#30359=PRODUCT('CS-111','Rail_4080x1410',
'Side rail, aluminium extrusion 40x80 slot 8 x 1410, 6063-T6, both end
s tapped M8',(#30357));
#30360=PRODUCT('CS-121','SliderBed',
'Slider bed 1410 x 310 x 3, 5052-H32, laser cut, 18 x 6.6 countersunk 
M6 into the rail slots; belt runs on it',(#30357));
#30361=PRODUCT('CS-112','Leg_4040x574',
'Leg, aluminium extrusion 40x40 slot 8 x 574, bottom tapped M8 (bolted
 down to the outrigger CS-116)',(#30357));
#30362=PRODUCT('CS-116','Outrigger_4040x700',
'Outrigger, aluminium extrusion 40x40 slot 8 x 700, under each leg pai
r: 2 x M8 leg bolts, 2 levelling feet at +-325 (foot track 650 mm, rep
laces floor anchors)',(#30357));
#30363=PRODUCT('CS-115','LevellingFoot_M8',
'Levelling foot M8, 50 mm nylon pad, zinc-plated stud (into the leg co
re thread)',(#30357));
#30364=PRODUCT('CS-113','BraceX_4040x1060',
'Lower longitudinal brace, 40x40 slot 8 x 1060',(#30357));
#30365=PRODUCT('CS-114','BraceY_4040x230',
'Lower cross brace, 40x40 slot 8 x 230',(#30357));
#30366=PRODUCT('CS-131','HeadPlate',
'Head end plate 165 x 134 x 6, 6061-T6: UCFL204 seat (26 + 2 x 11 on 9
0), 4 x 9 to the rail, 4 x 6.6 motor-mount (qty 2, L/R identical)',(#30357));
#30367=PRODUCT('CS-132','TailPlate',
'Tail end plate 175 x 134 x 6, 6061-T6: take-up slots +-15 mm for the 
UCFL204, 4 x 9 to the rail (qty 2, L/R identical)',(#30357));
#30368=PRODUCT('CS-141','GuideL1',
'Side guide L1, unequal angle 40 x 25 x 3, 6061-T6, length 490, inner 
face 103 from the belt centre, 10 mm through-beam window',(#30357));
#30369=PRODUCT('CS-142','GuideL2',
'Side guide L2, unequal angle 40 x 25 x 3, 6061-T6, length 220, inner 
face 103 from the belt centre',(#30357));
#30370=PRODUCT('CS-143','GuideL3',
'Side guide L3, unequal angle 40 x 25 x 3, 6061-T6, length 70, inner f
ace 103 from the belt centre',(#30357));
#30371=PRODUCT('CS-144','GuideR1',
'Side guide R1, unequal angle 40 x 25 x 3, 6061-T6, length 645, inner 
face 103 from the belt centre, 10 mm through-beam window',(#30357));
#30372=PRODUCT('CS-145','GuideR2',
'Side guide R2, unequal angle 40 x 25 x 3, 6061-T6, length 105, inner 
face 103 from the belt centre',(#30357));
#30373=PRODUCT('CS-151','ExitChute',
'Exit chute 240 wide, 1.5 mm 5052-H32, lip 57 + 300 at 35 deg, 60 mm s
ide walls (qty 2, L/R identical)',(#30357));
#30374=PRODUCT('CS-161','Tote600x400x420',
'Collection tote 600 x 400 x 420, polypropylene, stackable (envelope)',
(#30357));
#30375=PRODUCT('CS-202','DriveShaft',
'Drive shaft 20 h7 x 411, 1045 CD, 15 h7 coupling end with 1 mm flat',(#30357));
#30376=PRODUCT('CS-203','TailShaft','Tail shaft 20 h7 x 390, 1045 CD',(#30357));
#30377=PRODUCT('CS-201','Pulley60x210',
'Crowned pulley 60 x 210 face (trapezoidal crown 0.2 mm/side), 6061-T6
 tube 60 x 5 with integral hubs, 20 H7 bore, 2 x M6 set screws (qty 2,
 head + tail)',(#30357));
#30378=PRODUCT('CS-204','Belt200_PVC',
'Conveyor belt 200 x 2 mm, 2-ply PVC, endless (finger splice), pitch l
ength 3195 mm',(#30357));
#30379=PRODUCT('CS-211','UCFL204',
'Flanged bearing unit UCFL204 (2-bolt, 20 mm, set-screw insert UC204),
 Cr 12.8 kN, C0r 6.65 kN (NSK catalogue)',(#30357));
#30380=PRODUCT('CS-205','MotorMount',
'Motor mount, 6061-T6 machined U-bracket 84 x 104 x 90 (respec: +5 mm 
stand-off for the L-075): 6 mm front plate (16 pilot, 4 x 4.5 on 25 PC
D) + 2 legs tapped M6 into the head plate',(#30357));
#30381=PRODUCT('CS-221','goBILDA5203_50-9',
'goBILDA 5203 Yellow Jacket planetary gearmotor 50.9:1, 12 V, 117 rpm,
 6.71 Nm stall, 9.2 A stall, encoder 1425.1 PPR (envelope; face patter
n assumed)',(#30357));
#30382=PRODUCT('CS-222','JawCoupling_L075',
'Jaw coupling Lovejoy L-075, NBR spider, hubs bored 15 and 8 mm with s
et screws, 10.2 Nm (90 in-lb) rated',(#30357));
#30383=PRODUCT('CS-206','TakeUpBlock',
'Take-up block 20 x 30 x 30, 6061-T6, M10 jack-screw thread, 2 x 6.6 t
o the tail plate (qty 2)',(#30357));
#30384=PRODUCT('CS-313','GantryPost_2020x230',
'Sensor gantry post, 20x20 slot 6 x 230',(#30357));
#30385=PRODUCT('CS-312','GantryBeam_2020x310',
'Sensor gantry beam, 20x20 slot 6 x 310',(#30357));
#30386=PRODUCT('CS-331','ToFHead',
'ToF sensor head, 3D printed PETG, 30 x 36 x 20, pocket for the VL53L1
X carrier, M5 into the gantry beam',(#30357));
#30387=PRODUCT('CS-332','VL53L1X_Carrier',
'VL53L1X time-of-flight distance sensor carrier (Pololu 3415 class), l
ooks down: item height = 207.8 mm - range',(#30357));
#30388=PRODUCT('CS-334','BeamSensorBracket',
'Through-beam sensor bracket, 3D printed PETG, 24 x 27 x 48, M5 into t
he gantry post (qty 2)',(#30357));
#30389=PRODUCT('CS-333','ThroughBeam_E3Z',
'Through-beam photoelectric sensor (Omron E3Z-T61 class), 12-24 V PNP,
 1 ms response; emitter (+Y) / receiver (-Y)',(#30357));
#30390=PRODUCT('CS-341','ControlBox',
'Control box 200 x 80 x 44, 3D printed PETG, holds Arduino Mega + MD10
C driver + buck converter, 3 x M12 glands, M5 to the rail',(#30357));
#30391=PRODUCT('CS-342','ControlBoxLid',
'Control box lid 200 x 80 x 3, 3D printed PETG, 16 mm start/stop butto
n hole',(#30357));
#30392=PRODUCT('CS-321','ServoMount',
'Servo mount, 3D printed PA6-CF (Bambu), base 60 x 40 x 6 + 2 towers c
arrying the servo ears, 4 x M4 heat-set inserts',(#30357));
#30393=PRODUCT('CS-311','Servo_SB2290SG',
'Savox SB-2290SG HV brushless servo, 50 kg cm / 0.13 s per 60 deg at 7.
4 V, 25T spline, with aluminium disc horn (envelope)',(#30357));
#30394=PRODUCT('CS-322','DiverterHub',
'Diverter hub, 3D printed PA6-CF: 36 boss on the servo horn (4 x M3), 
84 mm arm, 3.2 slot clamping the paddle with 2 x M4',(#30357));
#30395=PRODUCT('CS-323','DiverterPaddle',
'Diverter paddle 301 x 60 x 3, 6061-T6 laser cut, PTFE tape on the ite
m face, 2 x 4.5 clamp holes',(#30357));
#30396=PRODUCT('CS-511','HexBolt_M10x35',
'Hex bolt ISO 4017 M10 x 35, 8.8 zinc (bearing flange to end plate)',(#30357));
#30397=PRODUCT('CS-513','Nut_M10_nyloc',
'Prevailing-torque nut ISO 10511 M10, class 8, zinc',(#30357));
#30398=PRODUCT('CS-514','BHCS_M8x12',
'Button head screw ISO 7380 M8 x 12 + slot-8 T-nut (end plate to rail)',
(#30357));
#30399=PRODUCT('CS-515','SHCS_M6x20',
'Socket head cap screw ISO 4762 M6 x 20, 10.9 (motor mount to head pla
te)',(#30357));

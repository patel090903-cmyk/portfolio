#32381=PRODUCT_CONTEXT('part definition',#32380,'mechanical');
#32382=PRODUCT('F1S-ASM-001','F1Suspension',
'F1-style double-wishbone pushrod front-left corner - top assembly (dr
iven by Heave / Steer)',(#32381));
#32383=PRODUCT('F1S-100','ChassisSection',
'Monocoque front section (reference geometry for the pickups; not part
 of the corner BOM)',(#32381));
#32384=PRODUCT('F1S-103','RackHousing',
'Steering rack housing (reference envelope, half shown)',(#32381));
#32385=PRODUCT('F1S-101','WishboneClevis',
'Chassis clevis bracket, 7075-T6 machined, M12 double shear, 4x M8 to 
monocoque inserts',(#32381));
#32386=PRODUCT('F1S-102','RockerMount',
'Rocker mount, 7075-T6 machined, d15 pivot pin double shear, 4x M8 to 
monocoque',(#32381));
#32387=PRODUCT('F1S-522','ScrewM8x20',
'Socket head cap screw ISO 4762 M8 x 20, class 12.9 (bracket to monoco
que insert)',(#32381));
#32388=PRODUCT('F1S-201','UpperWishbone',
'Upper wishbone, 4130 tube 22.2 x 1.65 TIG-welded, GE12E housings, nor
malised after welding',(#32381));
#32389=PRODUCT('F1S-202','LowerWishbone',
'Lower wishbone, 4130 tube 25.4 x 1.65 TIG-welded, 3 mm gusset, GE12E 
housings (LBJ bolt vertical)',(#32381));
#32390=PRODUCT('F1S-203','Upright',
'Front upright, 7075-T6 machined from billet: hub-bearing boss, UBJ/LB
J/steering/pushrod clevises, caliper lugs',(#32381));
#32391=PRODUCT('F1S-104','RackBar',
'Steering rack bar end with M12 tie-rod clevis, 17-4PH (rack teeth not
 modelled)',(#32381));
#32392=PRODUCT('F1S-205','TieRod',
'Tie rod (track rod), 4130 tube 22.2 x 1.65, M12 inserts, eye-to-eye 4
70.1 mm',(#32381));
#32393=PRODUCT('F1S-206','Rocker',
'Rocker (bell crank), twin 7075-T6 plates + hub, arms 60/80 mm, 2x SKF
 GE 15 ES (hub wall 10 mm)',(#32381));
#32394=PRODUCT('F1S-204','Pushrod',
'Pushrod, 4130 tube 25.4 x 2.11, M12 RH/LH inserts, eye-to-eye 653.1 m
m',(#32381));
#32395=PRODUCT('F1S-301','DamperBody',
'Damper Penske 8760 triple-adjustable, 45 mm bore, 2.25 in spring hard
ware, built to 241.2 mm static / 262.5 mm extended eye-to-eye, stroke 
63.5 mm (envelope)',(#32381));
#32396=PRODUCT('F1S-302','DamperShaft',
'Damper shaft + eye + lower spring perch (envelope)',(#32381));
#32397=PRODUCT('F1S-303','CoilSpring',
'Coil spring Hyperco 186A0900: 2.25 in ID, 6.0 in free, 900 lb/in (157.
6 N/mm), installed 142.2 mm (envelope: wire ~11.9, 3.86 active coils)',
(#32381));
#32398=PRODUCT('F1S-401','Hub',
'Front hub / stub axle, Ti-6Al-4V, centre-lock nose, disc bell',(#32381));
#32399=PRODUCT('F1S-402','HubBearing',
'Hub bearings 2x 7014 ACD/P4A angular contact back-to-back (70 x 110 x
 20 each) + 14 mm spacer ring (envelope)',(#32381));
#32400=PRODUCT('F1S-403','HubNut',
'Hub-bearing retaining nut M66x1.5, 4340 steel',(#32381));
#32401=PRODUCT('F1S-404','BrakeDisc',
'Brake disc iron 320 x 32, ventilated, floating on 12 bobbins (vanes n
ot modelled)',(#32381));
#32402=PRODUCT('F1S-406','Rim',
'Wheel rim 18 in x 12 in forged aluminium, centre lock (envelope)',(#32381));
#32403=PRODUCT('F1S-407','Tyre',
'Front slick 30/68-18 (680 mm OD, unloaded envelope)',(#32381));
#32404=PRODUCT('F1S-408','WheelNut',
'Centre-lock wheel nut M80x1.5, 7075-T6',(#32381));
#32405=PRODUCT('F1S-405','Caliper',
'Brake caliper, 6-piston monobloc for a 320 x 32 disc (envelope), 2x M
10 mount',(#32381));
#32406=PRODUCT('F1S-524','GE15ES',
'Spherical plain bearing SKF GE 15 ES (15 x 26 x 12, C0 85 kN), rocker
 pivot (x2)',(#32381));
#32407=PRODUCT('F1S-515','RockerPivotPin',
'Rocker pivot pin d15 h6 x 62, M12 thread, 4340 steel',(#32381));
#32408=PRODUCT('F1S-514','RodEndM12_Ball',
'Rod end M12 - ball (bore 12, sphere 22, B12)',(#32381));
#32409=PRODUCT('F1S-518','Spacer12x6C',
'High-misalignment cone spacer 12.2 / 14-19 x 6, 17-4PH',(#32381));
#32410=PRODUCT('F1S-513','RodEndM12',
'Rod end male M12x1.25 RH body (Fluro steel, C0 42 kN; h 50, C9, D 32)
 with jam nut',(#32381));
#32411=PRODUCT('F1S-511','GE12E_InnerRing',
'Spherical plain bearing GE 12 E - inner ring (d12, dk18, B10), catalo
gue dimensions',(#32381));
#32412=PRODUCT('F1S-519','Spacer12x7C',
'High-misalignment cone spacer 12.2 / 14-19 x 7, 17-4PH',(#32381));
#32413=PRODUCT('F1S-521','ScrewM12x55',
'Socket head cap screw ISO 4762 M12 x 55, class 12.9, black oxide',(#32381));
#32414=PRODUCT('F1S-523','LocknutM12',
'All-metal prevailing-torque locknut M12, class 10',(#32381));
#32415=PRODUCT('F1S-512','GE12E_OuterRing',

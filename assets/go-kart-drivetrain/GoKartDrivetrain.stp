#100918=PRODUCT('GK-ASM-001','GoKartDrivetrain',
'Electric go-kart rear drivetrain: ME1114 motor, #35 13/60 chain reduc
tion, 1-1/4 live axle (driven by ChainLine / ChainAdjust)',(#100917));
#100919=PRODUCT('GK-100','ChassisRearSection',
'Kart chassis rear section, 4130 1-1/4 x 0.083 tube (reference geometr
y for the mounts, not in the drivetrain BOM)',(#100917));
#100920=PRODUCT('GK-101','BearingHanger',
'Rear-axle bearing hanger, 3/8 in 4130 plate, R25 blends, saddled and 
TIG-welded to the main rail, 52 bore + 2 x 13.5',(#100917));
#100921=PRODUCT('GK-102','MotorMountBase',
'Motor-mount base plate 270 x 142 x 6, A36, welded across the two 1-1/
4 cross tubes, 4 x 10.5',(#100917));
#100922=PRODUCT('GK-103','MotorMountBracket',
'Motor mount bracket, 6061-T6 machined from solid: 3/8 in motor plate 
+ 3/8 in base flange with 4 x 24 mm tensioning slots + 2 gussets',(#100917));
#100923=PRODUCT('GK-201','ME1114_Motor',
'Motenergy ME1114 brushless PMSM, 24-72 V, 0.12 Nm/A, 65 Nm peak, 5000
 rpm, 7/8 shaft (catalogue envelope)',(#100917));
#100924=PRODUCT('GK-513','Key_3-16x19',
'Square key 3/16 x 3/16 x 19, 1018 CD (motor sprocket)',(#100917));
#100925=PRODUCT('GK-401','Sprocket35_13T',
'Sprocket ANSI 35 13T, 7/8 bore, 3/16 key, B-hub (PD 39.80, OD 44.36),
 1045, hardened teeth',(#100917));
#100926=PRODUCT('GK-301','RearAxle',
'Rear live axle 1-1/4 in x 40 in, 4140 pre-hard 28-32 HRC, 1/4 x 1/8 f
ull-length keyway, ends chamfered 1x45',(#100917));
#100927=PRODUCT('GK-302','AxleSprocketHub',
'Axle sprocket hub 1-1/4 bore, 1/4 keyseat, flange 104 x 8, 6 x 8.4 on
 3.25 in, 2 set screws, 6061-T6',(#100917));
#100928=PRODUCT('GK-511','Key_1-4x40',
'Square key 1/4 x 1/4 x 40, 1018 CD (sprocket hub)',(#100917));
#100929=PRODUCT('GK-402','Sprocket35_60T',
'Kart sprocket ANSI 35 60T plate, 7075-T6 hard anodised, bore 64, 6 x 
8.4 on 3.25 in (PD 182.00, OD 187.46)',(#100917));
#100930=PRODUCT('GK-403','Chain35_98L',
'Roller chain ANSI 35 single strand, 98 links incl. connecting link (9
33.5 mm), min tensile 9.34 kN',(#100917));
#100931=PRODUCT('GK-421','UCFL206_Housing',
'Flange housing UCFL206 2-bolt, cast iron, bolt centres 117 (catalogue
 dimensions)',(#100917));
#100932=PRODUCT('GK-422','UC206-20_Insert',
'Insert ball bearing UC206-20, 1-1/4 bore, set-screw locking, C 19.5 k
N, C0 11.3 kN',(#100917));
#100933=PRODUCT('GK-411','RearWheelHub',
'Rear wheel hub 1-1/4 bore x 80 long, 1/4 keyway, 4-bolt 90 mm flange,
 6061-T6 (kart catalogue type)',(#100917));
#100934=PRODUCT('GK-512','Key_1-4x70',

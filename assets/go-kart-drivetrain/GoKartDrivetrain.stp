#88627=PRODUCT_CONTEXT('part definition',#88626,'mechanical');
#88628=PRODUCT('GK-ASM-001','GoKartDrivetrain',
'Electric go-kart rear drivetrain: ME1114 motor, #40 13/50 chain reduc
tion, 1-1/4 live axle, hydraulic disc brake, chain guard (driven by Dr
ive / ChainLine / ChainAdjust)',(#88627));
#88629=PRODUCT('GK-100','ChassisRearSection',
'Kart chassis rear section, 4130 1-1/4 x 0.083 tube (reference geometr
y for the mounts, not in the drivetrain BOM)',(#88627));
#88630=PRODUCT('GK-101','BearingHanger',
'Rear-axle bearing hanger, 3/8 in 4130 plate, R25 blends, saddled and 
TIG-welded to the main rail, 52 bore + 2 x 13.5',(#88627));
#88631=PRODUCT('GK-102','MotorMountBase',
'Motor-mount base plate 270 x 142 x 6, A36, welded across the two 1-1/
4 cross tubes, 4 x 10.5',(#88627));
#88632=PRODUCT('GK-103','MotorMountBracket',
'Motor mount bracket, 6061-T6 machined from solid: 3/8 in motor plate 
+ 3/8 in base flange with 4 x 24 mm tensioning slots + 2 gussets',(#88627));
#88633=PRODUCT('GK-201','ME1114_Motor',
'Motenergy ME1114 brushless PMSM, 24-72 V, 0.12 Nm/A, 65 Nm peak, 5000
 rpm, 7/8 shaft (catalogue envelope)',(#88627));
#88634=PRODUCT('GK-201_1','ME1114_Shaft',
'Motenergy ME1114 output shaft 7/8 x 1-11/16, 3/16 key (part of the mo
tor, modelled separately so it turns)',(#88627));
#88635=PRODUCT('GK-513','Key_3-16x19',
'Square key 3/16 x 3/16 x 19, 1018 CD (motor sprocket)',(#88627));
#88636=PRODUCT('GK-401','Sprocket40_13T',
'Sprocket ANSI 40 13T, 7/8 bore, 3/16 key, B-hub 1.563 in (PD 53.07, O
D 59.15), steel, Martin 40BS13 7/8',(#88627));
#88637=PRODUCT('GK-421','UCFL206_Housing',
'Flange housing UCFL206 2-bolt, cast iron, bolt centres 117 (catalogue
 dimensions)',(#88627));
#88638=PRODUCT('GK-422','UC206-20_Insert',
'Insert ball bearing UC206-20, 1-1/4 bore, set-screw locking, C 19.5 k
N, C0 11.3 kN',(#88627));
#88639=PRODUCT('GK-301','RearAxle',
'Rear live axle 1-1/4 in x 40 in, 4140 pre-hard 28-32 HRC, 1/4 x 1/8 f
ull-length keyway, ends chamfered 1x45',(#88627));
#88640=PRODUCT('GK-402','Sprocket40_50T',
'Sprocket ANSI 40 50T, 1-1/4 bore + 1/4 keyway, B-hub 3.5 in, 2 set sc
rews (PD 202.26, OD 209.48), steel, Martin 40BS50 1-1/4: keyed straigh
t to the axle (no bolt-on hub)',(#88627));
#88641=PRODUCT('GK-403','Chain40_78L',
'Roller chain ANSI 40 single strand, 78 links incl. connecting link (9
90.6 mm), min tensile 13.9 kN (ANSI), max allowable 3.60 kN (Tsubaki)',
(#88627));
#88642=PRODUCT('GK-701','BrakeHub_KD125MB',
'Brake-disc hub 1-1/4 bore, 1/4 keyway, 3 x 1/4 on 2.75 in BC (GoPower
Sports KD125MB, catalogue-class envelope)',(#88627));
#88643=PRODUCT('GK-511','Key_1-4x25',
'Square key 1/4 x 1/4 x 25, 1018 CD (axle sprocket hub and brake hub, 
2)',(#88627));
#88644=PRODUCT('GK-702','BrakeDisc_180',
'Brake disc 7.1 in (180 mm) x 1/8 in steel, 3-bolt on 2.75 in (GoPower
Sports KD711.3)',(#88627));
#88645=PRODUCT('GK-704','CaliperBracket',
'Caliper bracket 1/4 in A36 plate 68 x 105, TIG-welded to the inboard 
face of the right bearing hanger, 2 x 8.5 for the caliper',(#88627));
#88646=PRODUCT('GK-703','Caliper_MidS',
'Hydraulic kart brake caliper (single piston, rear) envelope + master 
cylinder + line (GoPowerSports KDMIDSBRKIT)',(#88627));
#88647=PRODUCT('GK-705','ChainGuard',
'Chain and sprocket guard, 1.5 mm steel laser cut + bent: outboard sid
e plate + top cover over the tight span, bolted to the motor-mount bas
e (fixings not modelled)',(#88627));
#88648=PRODUCT('GK-411','RearWheelHub',
'Rear wheel hub 1-1/4 bore x 80 long, 1/4 keyway, 4-bolt 90 mm flange,
 6061-T6 (kart catalogue type)',(#88627));
#88649=PRODUCT('GK-512','Key_1-4x70',
'Square key 1/4 x 1/4 x 70, 1018 CD (wheel hubs)',(#88627));
#88650=PRODUCT('GK-412','Rim5x5',
'Kart rim 5 in dia x 5 in wide, cast aluminium (envelope)',(#88627));
#88651=PRODUCT('GK-413','Tyre11x7-10-5',
'Kart slick 11 x 7.10-5 (rear), envelope',(#88627));
#88652=PRODUCT('GK-528','Washer_M10_DIN125',
'Flat washer DIN 125 M10 (10.5 x 20 x 2), used under the 3/8 slot bolt
s',(#88627));
#88653=PRODUCT('GK-521','HexBolt_3-8x1.25',
'Hex head cap screw 3/8-16 x 1-1/4, SAE J429 grade 8, zinc-yellow (mot
or-mount slot bolts)',(#88627));
#88654=PRODUCT('GK-525','Locknut_3-8-16',
'Nylon-insert locknut 3/8-16, grade 8',(#88627));
#88655=PRODUCT('GK-522','HexBolt_3-8x1.00',
'Hex head cap screw 3/8-16 x 1, SAE grade 8 (motor face to mount plate
)',(#88627));
#88656=PRODUCT('GK-523','HexBolt_1-2x1.50',
'Hex head cap screw 1/2-13 x 1-1/2, SAE grade 8 (bearing flange to han
ger)',(#88627));
#88657=PRODUCT('GK-526','Locknut_1-2-13',
'Nylon-insert locknut 1/2-13, grade 8',(#88627));
ENDSEC;

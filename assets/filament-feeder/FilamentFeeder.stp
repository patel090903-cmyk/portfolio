#75954=APPLICATION_CONTEXT(
'Core Data for Automotive Mechanical Design Process');
#75955=PRODUCT_CONTEXT('part definition',#75954,'mechanical');
#75956=PRODUCT('FF-ASM-001','FilamentFeeder',
'Geared dual-drive Bowden filament feeder (1.75 mm): NEMA 17 + 3:1 m0.
5 gears, BMG-type drive gears, spring-loaded idler arm, PTFE path with
 push-fits, D2F runout switch, spool holder on a 2020 rail',(#75955));
#75957=PRODUCT('FF-601','Rail_2020x300',
'2020 V-slot / T-slot aluminium extrusion, 300 mm (6 mm slot, simplifi
ed profile)',(#75955));
#75958=PRODUCT('FF-500','FeederBody',
'Feeder body, printed PETG: gear + drive pockets, 683ZZ seat, filament
 guides, 2 x PC4-M10 threads, motor face, mounting flange (2 x M5 to t
he 2020 rail); print back face down, supports in the gear pocket',(#75955));
#75959=PRODUCT('FF-502','FeederCover',
'Feeder cover, printed PETG 4 mm: front 683ZZ seat, screw clearances',(#75955));
#75960=PRODUCT('FF-101','Motor_17HS19-2004S1',
'Stepper motor StepperOnline 17HS19-2004S1 (NEMA 17, 59 Ncm, 2.0 A, 48
 mm); 1.8 deg, 0.59 N m holding, 5 mm D shaft (envelope from the datas
heet)',(#75955));
#75961=PRODUCT('FF-504','RunoutBody',
'Runout sensor block, printed PETG: filament channel, D2F switch pocke
t, PC4-M10 outlet, 1 x M5 to the rail',(#75955));
#75962=PRODUCT('FF-505','RunoutLid',
'Runout lid, printed PETG 3 mm: clamps the switch, wire exit',(#75955));
#75963=PRODUCT('FF-311','Switch_D2F-01L',
'Microswitch Omron D2F-01L (lever), 0.1 A, hinge lever (envelope from 
the datasheet): the filament holds the lever down',(#75955));
#75964=PRODUCT('FF-506','SpoolUpright',
'Spool upright, printed PETG: 24 x 10 post with gussets, 60 x 20 foot 
(2 x M5 to the rail), 8 mm axle press bore',(#75955));
#75965=PRODUCT('FF-309','PTFE_RunoutToFeeder',
'PTFE tube 4 OD x 2 ID, 40 long (cut from a 1 m Capricorn XS / generic
 tube)',(#75955));
#75966=PRODUCT('FF-310','PTFE_Bowden_stub',
'PTFE tube 4 OD x 2 ID, 61 long (cut from a 1 m Capricorn XS / generic
 tube)',(#75955));
#75967=PRODUCT('FF-308','PC4-M10',
'Push-fit coupling PC4-M10 for 4 x 2 PTFE (envelope)',(#75955));
#75968=PRODUCT('FF-307','Spring_8x1x18',
'Compression spring, music wire: 8 OD x 1.0 wire x 18 free, 6.5 active
 coils, k 4.45 N/mm (calculated); installed 12 = 26.7 N',(#75955));
#75969=PRODUCT('FF-303','Bearing_683ZZ',
'Deep groove ball bearing 683ZZ 3x7x3, shielded',(#75955));
#75970=PRODUCT('FF-306','Axle_8x100',
'Spool axle, 8 mm steel rod x 100 (h9), pressed into the upright',(#75955));
#75971=PRODUCT('FF-305','Bearing_608ZZ',
'Deep groove ball bearing 608ZZ 8x22x7, shielded',(#75955));
#75972=PRODUCT('FF-701','SHCS_M3x35',
'Socket head cap screw ISO 4762 M3 x 35 class 12.9 (motor, through cov
er + body)',(#75955));
#75973=PRODUCT('FF-702','SHCS_M3x28',
'Socket head cap screw ISO 4762 M3 x 28 class 12.9 (idler pivot, into 
a heat-set insert)',(#75955));
#75974=PRODUCT('FF-703','SHCS_M3x8',
'Socket head cap screw ISO 4762 M3 x 8 (cover, runout lid; heat-set in
serts)',(#75955));
#75975=PRODUCT('FF-707','SHCS_M5x8',
'Socket head cap screw ISO 4762 M5 x 8 (feeder flange into T-nuts)',(#75955));
#75976=PRODUCT('FF-705','SHCS_M5x30',
'Socket head cap screw ISO 4762 M5 x 30 (runout block into a T-nut)',(#75955));
#75977=PRODUCT('FF-704','SHCS_M5x10',
'Socket head cap screw ISO 4762 M5 x 10 (feeder flange, upright foot i
nto T-nuts)',(#75955));
#75978=PRODUCT('FF-706','TNut_M5_2020',
'Drop-in T-nut M5 for 2020 6 mm slot',(#75955));
#75979=PRODUCT('FF-301','Shaft_3x30',
'Main drive shaft, hardened steel 3 h6 x 30',(#75955));
#75980=PRODUCT('FF-202','MainGear_48T',
'Spur gear 48T m0.5, brass, 5 wide, 3 bore with set screw (3:1 stage);
 brass, not POM: Lewis SF at the grip limit 1.3 in POM',(#75955));
#75981=PRODUCT('FF-102','MotorShaft',
'Motor shaft (split out of the motor so it can turn in the model; part
 of FF-101)',(#75955));
#75982=PRODUCT('FF-203','Pinion_16T',
'Motor pinion 16T m0.5, steel, 5 wide, 5 D bore',(#75955));
#75983=PRODUCT('FF-503','IdlerArm',
'Idler arm, printed PA6-CF: pivots on an M3 screw, carries the idler d
rive gear on 2 x MR63ZZ, spring pocket; lever ratio 2.00; PA6-CF, not 
PETG, because the spring load is constant (creep)',(#75955));
#75984=PRODUCT('FF-302','Shaft_3x16',
'Idler shaft, hardened steel 3 h6 x 16',(#75955));
#75985=PRODUCT('FF-304','Bearing_MR63ZZ',
'Deep groove ball bearing MR63ZZ 3x6x2.5, shielded',(#75955));
#75986=PRODUCT('FF-201','DriveGear_17T',
'Dual-drive gear, hardened steel: 17T m0.5 spur teeth (the pair mesh) 
+ hobbed section 8 OD with a 1.9 wide filament groove, effective grip 
diameter 7.36 (BMG pattern); 3 bore, 11 long. CAD is my envelope of th
e Bondtech-type gear: confirm the kit''s dimensions',(#75955));
#75987=PRODUCT('FF-501','SpoolHub',
'Spool hub, printed PETG: 52.4 OD (3 mm wall) for 53-58 mm spool bores
, 66 flange, two 608ZZ seats in 9 mm end walls',(#75955));
#75988=PRODUCT('FF-401','Spool_1kg',
'1 kg filament spool, 200 OD x 68 wide, 53 bore (envelope; wound filam
ent shown to r 88)',(#75955));
#75989=PRODUCT('FF-402','Filament_1.75',
'1.75 mm filament (the moving part; part of the spool FF-401)',(#75955));
ENDSEC;
END-ISO-10303-21;

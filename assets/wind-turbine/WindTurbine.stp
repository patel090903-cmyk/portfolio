#19832=APPLICATION_CONTEXT(
'Core Data for Automotive Mechanical Design Process');
#19833=PRODUCT_CONTEXT('part definition',#19832,'mechanical');
#19834=PRODUCT('WT-ASM-001','WindTurbine',
'1.3 m 3-blade upwind small wind turbine: printed ASA blades (SG6040/S
G6043), ATO 400 W 24 V PMG direct drive, furling tail, 2in Sch 40 guye
d tilt-up mast, hub height 6.2 m (driven by Yaw, Spin, Furl)',(#19833));
#19835=PRODUCT('WT-505','BaseHinge',
'Hinged base, welded S235: plate 300 x 300 x 12 with 4 x 14 for M12 an
chors in the concrete pad, two 10 mm lugs with 16.5 pin holes (the mas
t tilts down about the M16 pin); galvanised',(#19833));
#19836=PRODUCT('WT-501','MastLower_2inSch40_10ft',
'Mast lower: 2in Sch 40 galvanised steel pipe 60.3 x 3.91 x 10 ft (304
8), threaded top end, 16.5 hinge hole',(#19833));
#19837=PRODUCT('WT-517','HexBolt_M16x100',
'Hex bolt ISO 4014 M16 x 100 8.8 zinc (base hinge pin)',(#19833));
#19838=PRODUCT('WT-520','Nut_M16_nyloc',
'Nylon-insert lock nut DIN 985 M16 8 zinc (hinge pin)',(#19833));
#19839=PRODUCT('WT-503','Coupling_2inNPT',
'Pipe coupling 2in NPT, galvanised malleable iron (joins the mast leng
ths; thread modelled at the pipe OD)',(#19833));
#19840=PRODUCT('WT-502','MastUpper_2inSch40_10ft',
'Mast upper: 2in Sch 40 galvanised steel pipe 60.3 x 3.91 x 10 ft, thr
eaded bottom end; 2 x 10.5 for the yaw spindle bolts, 1 x 10.5 for the
 guy collar',(#19833));
#19841=PRODUCT('WT-504','GuyCollar',
'Guy collar, welded S235: 90 / 61 x 40 ring, 4 lugs 8 thick with 13 ho
les for 1/4in shackles, M10 cross bolt; galvanised',(#19833));
#19842=PRODUCT('WT-524','HexBolt_M10x110',
'Hex bolt ISO 4014 M10 x 110 8.8 zinc (guy collar cross bolt)',(#19833));
#19843=PRODUCT('WT-402','YawSpindle',
'Yaw spindle 1045: 52.2 plug in the 2in pipe (2 x M10 cross bolts), 76
 collar on the pipe end, 35 h6 spindle for 2 x 6007-2RS, DIN 471 groov
e, 22 bore for the generator cable',(#19833));
#19844=PRODUCT('WT-516','HexBolt_M10x80',
'Hex bolt ISO 4014 M10 x 80 8.8 zinc (yaw spindle and guy collar cross
 bolts)',(#19833));
#19845=PRODUCT('WT-519','Nut_M10_nyloc',
'Nylon-insert lock nut DIN 985 M10 8 zinc',(#19833));
#19846=PRODUCT('WT-403','Bearing_6007-2RS',
'Deep groove ball bearing 6007-2RS 35 x 62 x 14, sealed (C 16.8 kN, C0
 10.2 kN, SKF data)',(#19833));
#19847=PRODUCT('WT-511','Circlip_DIN471-35',
'Retaining ring DIN 471 35 x 1.5 (yaw spindle, above the upper 6007)',(#19833));
#19848=PRODUCT('WT-401','NacelleFrame',
'Nacelle frame, welded S235: yaw tube 76 (2 x 6007 seats 62 K6, bored 
after welding), 6 mm generator plate (40 hole, 4 x M6 C''bore on PCD 1
10), 6 mm arm plate, 2 gussets, hinge bracket and 33.4 hinge post tilt
ed 20 deg (1in Sch 80 pipe, M10 tapped end); zinc-rich primer + paint',
(#19833));
#19849=PRODUCT('WT-301','Generator_ATO-PMG-NE400WM_stator',
'Permanent-magnet generator ATO-PMG-NE400WM, 24 V 3-phase AC, 400 W at
 800 rpm (vendor curve), max 445 W, start torque <= 0.35 Nm, 4.5 kg, I
P54, class F; envelope from the vendor drawing (145 x 82, M16 shaft); 
mounting PCD 110 assumed',(#19833));
#19850=PRODUCT('WT-514','LHCS_M6x12_DIN7984',
'Low-head cap screw DIN 7984 M6 x 12 8.8 (generator to the frame plate
, C''bored flush; Loctite 243)',(#19833));
#19851=PRODUCT('WT-407','ThrustWasher_PTFE_50x34x2',
'PTFE thrust washer 48 x 34.4 x 1.9 (tail sleeve on the hinge collar)',
(#19833));
#19852=PRODUCT('WT-406','HingeCap',
'Hinge cap washer S235 50 x 5 (keeps the tail sleeve on the post), M10
 x 20 into the post end',(#19833));
#19853=PRODUCT('WT-515','SHCS_M10x20',
'SHCS ISO 4762 M10 x 20 8.8 (hinge cap into the post)',(#19833));
#19854=PRODUCT('WT-404','TailBoom',
'Tail boom, welded S235: 1-1/4in Sch 40 sleeve (35.0 bore on the 33.4 
post, 0.8 clearance) + 1in x 1in x 2 square tube 780 long, welded at 9
0 + 20 deg so the boom is level at rest; 3 x 6.4 for the vane bolts',(#19833));
#19855=PRODUCT('WT-405','TailVane',
'Tail vane 5052-H32 1.6 mm, 460 long, 200 -> 300 high (0.115 m2), 3 x 
M6 to the boom',(#19833));
#19856=PRODUCT('WT-518','HexBolt_M6x40_A2',
'Hex bolt ISO 4014 M6 x 40 A2 (tail vane to boom)',(#19833));
#19857=PRODUCT('WT-521','Nut_M6_nyloc_A2',
'Nylon-insert lock nut DIN 985 M6 A2 (tail vane)',(#19833));
#19858=PRODUCT('WT-301S','Generator_ATO-PMG-NE400WM_shaft',
'Generator rotor shaft (part of the ATO-PMG-NE400WM, split out so the 
rotor can turn in the model): 17 mm, 25 collar, M16x1.5 thread',(#19833));
#19859=PRODUCT('WT-201','Hub',
'Hub disc 6061-T6: 240 x 10 with 45 spigot, bore 17 H7 on the generato
r shaft (clamped by the M16x1.5 nut against the shaft collar), 6 x M8 
tapped through on r 80 / 110 for the blade roots',(#19833));
#19860=PRODUCT('WT-202','ClampPlate',
'Blade clamp plate 6061-T6 240 x 6, 40 centre hole (nut access), 6 x 8.
6 for the blade bolts (the inner 3 also clamp the spinner flange)',(#19833));
#19861=PRODUCT('WT-203','Spinner',
'Spinner (nose cone) 190 x 120, 2.4 wall, PETG printed flange down; fl
ange clamped under the 3 inner M8 blade bolts',(#19833));
#19862=PRODUCT('WT-523','Washer_17x30x2.5_A2',
'Washer ISO 7089 17 x 30 x 2.5 A2 (hub nut)',(#19833));
#19863=PRODUCT('WT-522','Nut_M16x1.5_nyloc_A2',
'Nylon-insert lock nut DIN 985 M16 x 1.5 fine A2 (hub on the generator
 shaft, 60 Nm: clamps the hub against the shaft collar)',(#19833));
#19864=PRODUCT('WT-513','SHCS_M8x40_A2',
'SHCS ISO 4762 M8 x 40 A2-70 (inner blade bolts, also clamp the spinne
r flange; Loctite 243, 12 Nm)',(#19833));
#19865=PRODUCT('WT-512','SHCS_M8x35_A2',
'SHCS ISO 4762 M8 x 35 A2-70 (clamp plate + blade root into the hub th
read; Loctite 243, 12 Nm)',(#19833));
#19866=PRODUCT('WT-101','BladeRoot',
'Blade root segment r 62-270: root block 44 x 20 (2 x 8.6 holes for M8
 on r 80 / 110), SG6040 section, chord 125, twist 20.9 deg; 2 x 5.2 ro
d holes; printed ASA, span vertical',(#19833));
#19867=PRODUCT('WT-102','BladeMid',
'Blade mid segment r 270-460: SG6040 -> SG6043 blend, chord 100 -> 65,
 twist 13.6 -> 7.0 deg; 2 x 5.2 + 2 x 3.2 rod holes; printed ASA, span
 vertical',(#19833));
#19868=PRODUCT('WT-103','BladeTip',
'Blade tip segment r 460-650: SG6043, chord 65 -> 47, twist 7.0 -> 4.0
 deg; 2 x 3.2 rod holes; printed ASA, span vertical',(#19833));
#19869=PRODUCT('WT-104','CarbonRod_5x130',
'Pultruded carbon fibre rod 5 mm x 130 mm (cut from 1 m), bonded acros
s a blade joint with epoxy',(#19833));
#19870=PRODUCT('WT-105','CarbonRod_3x90',
'Pultruded carbon fibre rod 3 mm x 90 mm (cut from 1 m), bonded across
 a blade joint with epoxy',(#19833));
ENDSEC;
END-ISO-10303-21;

#125347=PRODUCT_CONTEXT('part definition',#125346,'mechanical');
#125348=PRODUCT('PG-ASM-001','PlanetaryGearbox',
'Single-stage planetary reducer 5:1 for a NEMA 17 stepper: KHK m1 gear
s 20/30/80, 4 planets, carrier output on 2 x 6001, printed bench brack
et (driven by Input)',(#125347));
#125349=PRODUCT('PG-105','MountBracket',
'Bench mount bracket, PETG printed (upright face down on the bed): 42 
nose hole, 4 x 5.5 on 100 PCD, 4 x M6 slots, 2 gussets',(#125347));
#125350=PRODUCT('PG-102','OutputHousing',
'Output housing, 6061-T6: 110 H7 ring recess, 6 x M4 clamp threads, 2 
x 6001 seats 28 J7 with a 24 shoulder, 4 x M5 mounting face on 100 PCD',
(#125347));
#125351=PRODUCT('PG-213','Ring_KHK_SI1-80',
'Ring gear KHK SI1-80: internal m1 z80, S45C black oxide, 110 OD x 10;
 MODIFIED: 6 x 4.5 thru on 98 PCD for the clamp bolts',(#125347));
#125352=PRODUCT('PG-101','MotorAdapter',
'Motor adapter, 6061-T6: NEMA 17 face (22 H7 pilot, 4 x M3 on 31), 110
 H7 recess 3 deep for the ring, 6 x 4.5 on 98 PCD',(#125347));
#125353=PRODUCT('PG-201','Stepper_17HS19-2004S1',
'Stepper motor StepperOnline 17HS19-2004S1: NEMA 17, 0.59 Nm holding, 
2.0 A, 1.6 ohm, 3.0 mH, 5 mm D-shaft x 24 (datasheet A0842); radial lo
ad 21 N max at 20 mm',(#125347));
#125354=PRODUCT('PG-222','Bearing_6001-2RSH',
'Ball bearing SKF 6001-2RSH 12 x 28 x 8, sealed, C 5.4 kN, C0 2.36 kN;
 output shaft (2)',(#125347));
#125355=PRODUCT('PG-211','Sun_KHK_SS1-20A',
'Sun gear KHK SS1-20A: spur m1 z20, 20 deg, S45C black oxide, 10 face,
 bore 5 H8 + M4 set screw onto the motor D-flat',(#125347));
#125356=PRODUCT('PG-103','Carrier',
'Planet carrier with integral 12 mm output shaft, 1045 CD: 70 x 8 plat
e, 4 x 5 P7 pin bores (press) on 50 PCD, 6001 seats 12 k5, DIN 471 gro
ove, 1 mm D-flat',(#125347));
#125357=PRODUCT('PG-231','Circlip_DIN471-12',
'Retaining ring DIN 471 12 x 1 (groove 11.5 x 1.1), McMaster 98541A119',
(#125347));
#125358=PRODUCT('PG-104','PlanetPin_5x30',
'Planet pin 5 h6 x 30, hardened ground shaft (Misumi SFJ/PSFJ 5 mm cla
ss, cut to length), DIN 6799 groove; press fit into the carrier',(#125347));
#125359=PRODUCT('PG-232','Eclip_DIN6799-4',
'Retaining washer DIN 6799 RS 4 (E-clip, groove 4 x 0.64) on the plane
t pin',(#125347));
#125360=PRODUCT('PG-233','Shim_DIN988-5x10x0.5',
'Shim ring DIN 988 5 x 10 x 0.5 between planet bearing and carrier',(#125347));
#125361=PRODUCT('PG-212','Planet_KHK_SS1-30',
'Planet gear KHK SS1-30: spur m1 z30, 20 deg, S45C black oxide, 10 fac
e, plain bore 10 (2 x MR105ZZ, Loctite 641)',(#125347));
#125362=PRODUCT('PG-221','Bearing_MR105ZZ',
'Ball bearing NSK MR105ZZ 5 x 10 x 4, shielded, Cr 475 N, C0r 168 N (n
sk.com); 2 per planet',(#125347));
#125363=PRODUCT('PG-241','SHCS_M4x35',
'Socket head cap screw ISO 4762 M4 x 35, 12.9 (adapter + ring into the
 housing, 6)',(#125347));
#125364=PRODUCT('PG-242','SHCS_M3x8',
'Socket head cap screw ISO 4762 M3 x 8, 12.9 (adapter to motor, 4)',(#125347));
#125365=PRODUCT('PG-243','SHCS_M5x16',
'Socket head cap screw ISO 4762 M5 x 16, 12.9 + washer (bracket to hou
sing, 4)',(#125347));

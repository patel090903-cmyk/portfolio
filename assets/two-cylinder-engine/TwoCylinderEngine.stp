#125043=PRODUCT('TCE-ASM-001','TwoCylinderEngine',
'296 cc air-cooled 180 deg parallel twin, DOHC 8 valves (direct bucket
s), two-main pressed crank on 2 x 6306, one-piece rods on K28x34x17 ne
edles, Kawasaki EX300 donor pistons / valve train; driven by Crank (72
0 deg cycle)',(#125042));
#125044=PRODUCT('TCE-401','CrankcaseUpper',
'Upper crankcase, horizontally split at the crank axis: crank chamber 
R55, 2 x 6306 half seats (line-bored with the lower case), 68.2 liner 
spigot bores, 8 x M8 stud threads, cam-chain cavity, 30x47x7 seal bore
; one-off from billet',(#125042));
#125045=PRODUCT('TCE-402','CrankcaseLower',
'Lower crankcase + wet sump (about 1.8 L): 2 x 6306 half seats line-bo
red with TCE-401, 6 x M8 case bolts from below, spin-on filter boss (M
20x1.5) on the rear, M12x1.5 drain, 4 x M10 test-stand mount threads; 
one-off from billet',(#125042));
#125046=PRODUCT('TCE-410','BaseGasket',
'Base gasket, 0.5 fibre sheet, cut in-house (thickness also sets the d
eck clearance)',(#125042));
#125047=PRODUCT('TCE-403','CylinderBlock',
'Cylinder block, air-cooled: 2 x 68 H7 liner bores on 76 centres, 7 fi
ns 2.5 at 8 pitch, 8 stud bosses, cam-chain tunnel with tensioner bore
; one-off from billet',(#125042));
#125048=PRODUCT('TCE-404','Liner',
